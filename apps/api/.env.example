# Local database from `pnpm db:up`. Never point local development at production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/decar
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/decar
# REDIS_URL=redis://localhost:6379  # optional, omit if not using Redis
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-me-32-chars-minimum-secret
JWT_REFRESH_SECRET=change-me-different-secret

# Must match apps/web
NEXTAUTH_SECRET=change-me-32-chars-minimum-secret
API_INTERNAL_SECRET=change-me-internal-shared-secret

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=decar-media

# Optional: Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=

PORT=3001
NODE_ENV=development
