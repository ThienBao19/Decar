generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  TRIALING
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  HYDROGEN
}

enum MediaType {
  EXTERIOR_IMAGE
  INTERIOR_IMAGE
  ENGINE_IMAGE
  EXTERIOR_3D
  INTERIOR_3D
  ENGINE_3D
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  comparisons   VehicleComparison[]
  builds        VehicleBuild[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String              @id @default(cuid())
  make         String
  model        String
  year         Int
  market       String
  trimLevel    String?
  slug         String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  engine       Engine?
  exterior     Exterior?
  interior     Interior?
  media        Media[]
  comparisonsA VehicleComparison[] @relation("VehicleA")
  comparisonsB VehicleComparison[] @relation("VehicleB")

  @@index([make, model, year])
  @@index([slug])
}

model Engine {
  id           String   @id @default(cuid())
  vehicleId    String   @unique
  displacement Float
  cylinders    Int
  fuelType     FuelType
  powerKw      Int
  torqueNm     Int
  transmission String
  drivetrain   String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Exterior {
  id          String  @id @default(cuid())
  vehicleId   String  @unique
  bodyType    String
  lengthMm    Int
  widthMm     Int
  heightMm    Int
  wheelbaseMm Int
  colors      Color[]
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Color {
  id         String   @id @default(cuid())
  exteriorId String
  name       String
  hexCode    String
  isPrimary  Boolean  @default(false)
  exterior   Exterior @relation(fields: [exteriorId], references: [id], onDelete: Cascade)
}

model Interior {
  id           String  @id @default(cuid())
  vehicleId    String  @unique
  seatMaterial String
  seatRows     Int
  seatCount    Int
  dashboard    String
  techFeatures String[]
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Media {
  id         String    @id @default(cuid())
  vehicleId  String
  storageKey String
  type       MediaType
  isPro      Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, type])
}

model VehicleComparison {
  id         String   @id @default(cuid())
  userId     String
  vehicleAId String
  vehicleBId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleA   Vehicle  @relation("VehicleA", fields: [vehicleAId], references: [id])
  vehicleB   Vehicle  @relation("VehicleB", fields: [vehicleBId], references: [id])

  @@index([userId])
}

model VehicleBuild {
  id         String   @id @default(cuid())
  userId     String
  name       String
  configJson Json
  thumbnail  String?
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
}
