NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-32-chars-minimum-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@decar.io

# Internal API (server-side only)
API_URL=http://localhost:3001
API_INTERNAL_SECRET=change-me-internal-shared-secret

# Stripe (client-safe publishable key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# API URL for client-side fetches (browser)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Prisma (used by NextAuth PrismaAdapter on web side)
# Local database from `pnpm db:up`. Never point local development at production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/decar
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/decar
