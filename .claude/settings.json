{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node E:/decar/.claude/hooks/planner.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node E:/decar/.claude/hooks/coding-style.js",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node E:/decar/.claude/hooks/code-review.js",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node E:/decar/.claude/hooks/testing.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node E:/decar/.claude/hooks/security.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
