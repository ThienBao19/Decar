    "@typescript-eslint/parser": "^7.0.0",
    "draco3dgltf": "1.5.9",
    "eslint": "^8.57.0",
    "meshoptimizer": "1.3.0",
    "prettier": "^3.3.0",
    "sharp": "0.35.5",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
